    <!-- JavaScript Logic & Canvas Renderer -->
    <script>
        // Canvas & Context Setup
        const canvas = document.getElementById('simCanvas');
        const ctx = canvas.getContext('2d');

        // State Variables
        let stim = 80;   // 10 - 100
        let tone = 20;   // 0 - 100
        let dist = 0.8;  // 0.5 - 4.0 meters
        let agi = 0;
        let oasLevel = 3;

        // Current Active Mission Target
        let activeMission = {
            targetAGI: 35,
            targetOAS: 1,
            minDist: 2.0,
            description: "ปรับค่าตัวแปรเพื่อสยบวิกฤตผู้ป่วยลงให้อยู่ในภาวะปลอดภัย (OAS Level <= 1) โดยที่ดัชนี AGI ต้องต่ำกว่า 35 คะแนน และรักษา Physical Distance ไม่ต่ำกว่า 2.0 เมตร"
        };

        // Animation Loop Variables
        let animationFrameId;
        let pAnimOffset = 0;
        let nurseX = 100;
        let patientX = 300;

        // Initialize Canvas Dimensions on Load and Resize
        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
        }

        window.addEventListener('resize', () => {
            resizeCanvas();
            drawSimulation();
        });

        // Simulation Calculation Logic
        function calculateState() {
            // Formula Calculation
            // High dist reduces threat, high tone reduces agi, high stim increases agi
            const distanceFactor = (1 / dist) * 18;
            agi = Math.max(0, Math.min(100, (stim * 0.45) + distanceFactor - (tone * 0.45) + 15));

            // Determine OAS Level based on AGI
            if (agi >= 75) {
                oasLevel = 3; // OAS Level 3: Severe Verbal / Physical Object Aggression
            } else if (agi >= 50) {
                oasLevel = 2; // OAS Level 2: Moderate Verbal Aggression
            } else if (agi >= 25) {
                oasLevel = 1; // OAS Level 1: Mild Restlessness / Mild Verbal Loudness
            } else {
                oasLevel = 0; // OAS Level 0: Calm & Cooperative
            }
        }

        // Update UI Text & Visual States
        function updateSimulation() {
            // Read Slider Values
            stim = parseFloat(document.getElementById('slider-stim').value);
            tone = parseFloat(document.getElementById('slider-tone').value);
            dist = parseFloat(document.getElementById('slider-dist').value);

            // Update Value Displays
            document.getElementById('val-stim').innerText = `${stim} %`;
            document.getElementById('val-tone').innerText = `${tone} %`;
            document.getElementById('val-dist').innerText = `${dist.toFixed(1)} เมตร`;

            // Calculate Math
            calculateState();

            // Update Calculated Displays
            document.getElementById('calc-agi').innerText = agi.toFixed(1);
            document.getElementById('calc-oas').innerText = `Level ${oasLevel}`;

            // Update Top Status Bar Badge
            const statusDot = document.getElementById('status-dot');
            const statusText = document.getElementById('status-text');
            const hrDisplay = document.getElementById('hr-display');
            const halluDisplay = document.getElementById('hallu-display');
            const dangerOverlay = document.getElementById('danger-overlay');

            const simulatedHR = Math.round(70 + (agi * 0.7));
            hrDisplay.innerText = simulatedHR;

            if (oasLevel === 3) {
                statusDot.className = "w-3 h-3 rounded-full bg-red-500 animate-pulse";
                statusText.className = "text-xs font-bold text-red-400";
                statusText.innerText = "ผู้ป่วยคลั่ง/ก้าวร้าวรุนแรง (Active Violent Crisis - OAS 3)";
                halluDisplay.innerText = "Severe";
            } else if (oasLevel === 2) {
                statusDot.className = "w-3 h-3 rounded-full bg-amber-500 animate-pulse";
                statusText.className = "text-xs font-bold text-amber-400";
                statusText.innerText = "ผู้ป่วยเสียงดังโวยวาย/หวาดระแวง (Moderate Agitation - OAS 2)";
                halluDisplay.innerText = "Moderate";
            } else if (oasLevel === 1) {
                statusDot.className = "w-3 h-3 rounded-full bg-yellow-400";
                statusText.className = "text-xs font-bold text-yellow-300";
                statusText.innerText = "ผู้ป่วยตึงเครียดกระสับกระส่าย (Mild Tension - OAS 1)";
                halluDisplay.innerText = "Mild";
            } else {
                statusDot.className = "w-3 h-3 rounded-full bg-emerald-500";
                statusText.className = "text-xs font-bold text-emerald-400";
                statusText.innerText = "ผู้ป่วยสงบนิ่ง/ร่วมมือ (Calm & Controlled - OAS 0)";
                halluDisplay.innerText = "Minimal";
            }

            // Danger Overlay Visibility
            if (dist < 1.0 && oasLevel >= 2) {
                dangerOverlay.classList.remove('hidden');
            } else {
                dangerOverlay.classList.add('hidden');
            }

            // Dynamic Clinical Interpretation Update
            updateExplanationText();
        }

        function updateExplanationText() {
            const expBox = document.getElementById('explanation-box');
            let text = "";

            if (oasLevel === 3) {
                text = `<span class="text-red-400 font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i> สภาวะวิกฤตขั้นรุนแรง (OAS Level 3):</span> สาร Methamphetamine กระตุ้น Dopamine ในสมองสูงมากร่วมกับสิ่งกระตุ้นสิ่งแวดล้อมปะทุขึ้น ผู้ป่วยมีภาวะหวาดระแวงอย่างรุนแรง (Paranoid Delusion) เห็นภาพหลอน การเข้าใกล้ระยะ < 1 เมตร หรือใช้น้ำเสียงสั่งการจะถูกตีความว่าเป็นการคุกคามชีวิตทันที <u>ข้อควรปฏิบัติ:</u> ถอยเว้นระยะห่าง > 2.5 เมตร นำสิ่งของอันตรายออก และเตรียมทีมสยบวิกฤต 5 คน`;
            } else if (oasLevel === 2) {
                text = `<span class="text-amber-400 font-bold"><i class="fa-solid fa-circle-exclamation mr-1"></i> สภาวะก้าวร้าวระดับปานกลาง (OAS Level 2):</span> ผู้ป่วยเริ่มตะโกนข่มขู่ โวยวาย แต่ยังไม่มีการทำร้ายร่างกายโดยตรง หากพยาบาลใช้น้ำเสียงสงบนิ่ง (De-escalation > 60%) และเปิดโอกาสให้ผู้ป่วยได้ระบายความรู้สึก จะช่วยลดระดับ Dopamine & Arousal ในสมองลงได้อย่างชัดเจน`;
            } else if (oasLevel === 1) {
                text = `<span class="text-yellow-300 font-bold"><i class="fa-solid fa-info-circle mr-1"></i> สภาวะกระสับกระส่าย (OAS Level 1):</span> ผู้ป่วยเริ่มสงบลง สามารถรับฟังคำสั่งง่ายๆ ได้ดี การรักษาระยะห่างที่เหมาะสม (2-3 เมตร) ช่วยให้ผู้ป่วยรู้สึกปลอดภัย ไม่ถูกคุกคาม`;
            } else {
                text = `<span class="text-emerald-400 font-bold"><i class="fa-solid fa-circle-check mr-1"></i> สภาวะควบคุมได้สมบูรณ์ (OAS Level 0):</span> เทคนิคการพยาบาลประสบผลสำเร็จระดับสูงสุด! การลดสิ่งกระตุ้นร่วมกับการใช้น้ำเสียง De-escalation นุ่มนวล ทำให้เกิดสัมพันธภาพเพื่อการบำบัด (Therapeutic Relationship) ผู้ป่วยพร้อมรับการตรวจรักษาและการบริหารยาอย่างปลอดภัย`;
            }

            expBox.innerHTML = text;
        }

        function resetSliders() {
            document.getElementById('slider-stim').value = 80;
            document.getElementById('slider-tone').value = 20;
            document.getElementById('slider-dist').value = 0.8;
            updateSimulation();
        }

        // HTML5 Canvas Rendering Engine
        function drawSimulation() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const centerY = canvas.height / 2 + 20;
            const widthScale = canvas.width / 400;

            // Map Dist slider (0.5m - 4.0m) to Canvas Pixels
            nurseX = 60 * widthScale;
            patientX = nurseX + (dist * 70 * widthScale);

            // Draw Background Environment Grid / Floor
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;
            for (let x = 0; x < canvas.width; x += 30) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }

            // Draw Distance Zone Line & Indicator
            ctx.beginPath();
            ctx.setLineDash([5, 5]);
            ctx.strokeStyle = dist < 1.5 ? '#ef4444' : '#10b981';
            ctx.moveTo(nurseX, centerY + 50);
            ctx.lineTo(patientX, centerY + 50);
            ctx.stroke();
            ctx.setLineDash([]);

            // Distance Text Label
            ctx.fillStyle = dist < 1.5 ? '#fca5a5' : '#6ee7b7';
            ctx.font = '12px Sarabun';
            ctx.textAlign = 'center';
            ctx.fillText(`ระยะห่าง: ${dist.toFixed(1)} m`, (nurseX + patientX) / 2, centerY + 70);

            // Draw Stimulation Aura Waves if high stimulation
            if (stim > 50) {
                ctx.beginPath();
                ctx.arc(patientX, centerY - 20, (stim * 0.8), 0, Math.PI * 2);
                ctx.fillStyle = `rgba(239, 68, 68, ${stim / 800})`;
                ctx.fill();
            }

            // Draw Nurse Character
            drawNurse(nurseX, centerY);

            // Draw Patient Character with Agitation Animation
            drawPatient(patientX, centerY);

            // Hallucination Effect Animation overlay if AGI is high
            if (agi > 60) {
                pAnimOffset += 0.1;
                ctx.strokeStyle = 'rgba(168, 85, 247, 0.4)';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(patientX + Math.sin(pAnimOffset) * 5, centerY - 50, 40 + Math.cos(pAnimOffset) * 10, 0, Math.PI * 2);
                ctx.stroke();
            }

            requestAnimationFrame(drawSimulation);
        }

        // Draw Nurse Sprite
        function drawNurse(x, y) {
            // Head
            ctx.fillStyle = '#e2e8f0';
            ctx.beginPath();
            ctx.arc(x, y - 50, 16, 0, Math.PI * 2);
            ctx.fill();

            // Nurse Cap
            ctx.fillStyle = '#0284c7';
            ctx.fillRect(x - 12, y - 68, 24, 6);

            // Body (Medical Uniform)
            ctx.fillStyle = '#0ea5e9';
            ctx.beginPath();
            ctx.roundRect(x - 14, y - 32, 28, 45, 6);
            ctx.fill();

            // Calming Hand Pose Signal
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(x + 10, y - 20);
            ctx.lineTo(x + 24, y - 15); // Hand pointing gently forward
            ctx.stroke();

            // Label
            ctx.fillStyle = '#38bdf8';
            ctx.font = 'bold 12px Kanit';
            ctx.textAlign = 'center';
            ctx.fillText('พยาบาล', x, y + 30);
        }

        // Draw Patient Sprite with Agitation Effects
        function drawPatient(x, y) {
            // Shake effect based on AGI
            const shakeX = (Math.random() - 0.5) * (agi / 15);
            const shakeY = (Math.random() - 0.5) * (agi / 15);
            const px = x + shakeX;
            const py = y + shakeY;

            // Aggressive Red Aura
            if (oasLevel >= 2) {
                ctx.fillStyle = oasLevel === 3 ? 'rgba(239, 68, 68, 0.3)' : 'rgba(245, 158, 11, 0.2)';
                ctx.beginPath();
                ctx.arc(px, py - 30, 35, 0, Math.PI * 2);
                ctx.fill();
            }

            // Head
            ctx.fillStyle = oasLevel >= 2 ? '#fca5a5' : '#fed7aa';
            ctx.beginPath();
            ctx.arc(px, py - 50, 16, 0, Math.PI * 2);
            ctx.fill();

            // Angry / Hallucinating Eyes Expression
            ctx.fillStyle = oasLevel >= 2 ? '#dc2626' : '#475569';
            ctx.beginPath();
            ctx.arc(px - 5, py - 53, 3, 0, Math.PI * 2);
            ctx.arc(px + 5, py - 53, 3, 0, Math.PI * 2);
            ctx.fill();

            // Body
            ctx.fillStyle = '#475569';
            ctx.beginPath();
            ctx.roundRect(px - 15, py - 32, 30, 45, 6);
            ctx.fill();

            // Aggressive Arm Gestures based on OAS Level
            ctx.strokeStyle = '#fca5a5';
            ctx.lineWidth = 4;
            ctx.beginPath();
            if (oasLevel === 3) {
                // Arms raised shouting / violent
                ctx.moveTo(px - 12, py - 25);
                ctx.lineTo(px - 25, py - 50);
                ctx.moveTo(px + 12, py - 25);
                ctx.lineTo(px + 28, py - 48);
            } else if (oasLevel === 2) {
                // Pointing threat
                ctx.moveTo(px - 12, py - 25);
                ctx.lineTo(px - 22, py - 15);
                ctx.moveTo(px + 12, py - 25);
                ctx.lineTo(px + 25, py - 30);
            } else {
                // Arms down
                ctx.moveTo(px - 12, py - 25);
                ctx.lineTo(px - 18, py - 5);
                ctx.moveTo(px + 12, py - 25);
                ctx.lineTo(px + 18, py - 5);
            }
            ctx.stroke();

            // Label
            ctx.fillStyle = oasLevel >= 2 ? '#f87171' : '#cbd5e1';
            ctx.font = 'bold 12px Kanit';
            ctx.textAlign = 'center';
            ctx.fillText(`ผู้ป่วย (OAS ${oasLevel})`, px, py + 30);
        }

        // Mission Modal Logic
        function openMissionModal() {
            document.getElementById('m-status-agi').innerText = agi.toFixed(1);
            document.getElementById('m-status-oas').innerText = `Level ${oasLevel}`;
            document.getElementById('m-status-dist').innerText = `${dist.toFixed(1)} m`;

            const fb = document.getElementById('mission-feedback');
            fb.classList.add('hidden');

            document.getElementById('mission-modal').classList.remove('hidden');
        }

        function closeMissionModal() {
            document.getElementById('mission-modal').classList.add('hidden');
        }

        function checkMissionResult() {
            const fb = document.getElementById('mission-feedback');
            fb.classList.remove('hidden');

            const isAGIPassed = agi <= activeMission.targetAGI;
            const isOASPassed = oasLevel <= activeMission.targetOAS;
            const isDistPassed = dist >= activeMission.minDist;

            if (isAGIPassed && isOASPassed && isDistPassed) {
                fb.className = "p-3 rounded-xl text-center font-bold bg-emerald-950/80 border border-emerald-500 text-emerald-300 text-xs md:text-sm";
                fb.innerHTML = `<i class="fa-solid fa-circle-check text-lg mr-1"></i> ยินดีด้วย! คุณผ่านภารกิจสำเร็จตามหลักการพยาบาลฉุกเฉินจิตเวช!`;
            } else {
                fb.className = "p-3 rounded-xl text-center font-bold bg-red-950/80 border border-red-500 text-red-300 text-xs md:text-sm";
                let failReason = "ยังไม่ผ่านภารกิจ: ";
                if (!isAGIPassed) failReason += `ดัชนี AGI ยังสูงเกินเป้าหมาย (${agi.toFixed(1)} / ${activeMission.targetAGI}) `;
                if (!isOASPassed) failReason += `OAS Level ยังสูงเกินไป `;
                if (!isDistPassed) failReason += `ระยะห่างใกล้อันตรายเกินไป `;
                fb.innerHTML = `<i class="fa-solid fa-circle-xmark text-lg mr-1"></i> ${failReason}`;
            }

            // Update live modal stats
            document.getElementById('m-status-agi').innerText = agi.toFixed(1);
            document.getElementById('m-status-oas').innerText = `Level ${oasLevel}`;
            document.getElementById('m-status-dist').innerText = `${dist.toFixed(1)} m`;
        }

        function generateRandomMission() {
            const missions = [
                {
                    targetAGI: 35,
                    targetOAS: 1,
                    minDist: 2.0,
                    description: "ภารกิจ 1: สยบวิกฤตผู้ป่วยให้เข้าสู่ภาวะปลอดภัย (OAS Level <= 1) โดยที่ AGI < 35 และรักษาระยะห่างไม่ต่ำกว่า 2.0 เมตร"
                },
                {
                    targetAGI: 20,
                    targetOAS: 0,
                    minDist: 2.5,
                    description: "ภารกิจ 2 (ขั้นสูง): สร้างสัมพันธภาพสมบูรณ์ สยบอาการผู้ป่วยให้อยู่ในสภาวะสงบนิ่ง (OAS Level 0) โดยที่ AGI < 20 และรักษาระยะห่างปลอดภัย 2.5 เมตรขึ้นไป"
                },
                {
                    targetAGI: 45,
                    targetOAS: 2,
                    minDist: 3.0,
                    description: "ภารกิจ 3 (ควบคุมสิ่งแวดล้อม): ลดความก้าวร้าวรุนแรงในระยะไกล โดยรักษา Physical Distance ไม่ต่ำกว่า 3.0 เมตร และลด AGI ให้ต่ำกว่า 45"
                }
            ];

            const randomIndex = Math.floor(Math.random() * missions.length);
            activeMission = missions[randomIndex];

            document.getElementById('mission-target-text').innerHTML = activeMission.description;
            document.getElementById('mission-feedback').classList.add('hidden');
        }

        // Window Onload Initialization
        window.onload = function() {
            resizeCanvas();
            updateSimulation();
            drawSimulation();
        };
    </script>
</body>
