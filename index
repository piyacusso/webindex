            <!-- Graphic Display Screen Canvas -->
            <div class="custom-glass rounded-2xl border border-slate-700/50 shadow-xl overflow-hidden flex flex-col h-[380px] md:h-[420px] relative">
                <!-- Canvas Top Bar Status -->
                <div class="bg-navy-900/80 px-4 py-2.5 border-b border-slate-800 flex justify-between items-center z-10 backdrop-blur-md">
                    <div class="flex items-center space-x-2">
                        <span id="status-dot" class="w-3 h-3 rounded-full bg-red-500 animate-pulse"></span>
                        <span id="status-text" class="text-xs font-bold text-red-400">ผู้ป่วยอาละวาด/ระแวงรุนแรง (Active Agitation)</span>
                    </div>
                    <div class="text-[11px] text-slate-400 flex items-center gap-3">
                        <span><i class="fa-solid fa-heart-pulse text-red-500 mr-1"></i> HR: <span id="hr-display" class="font-bold text-slate-200">135</span> bpm</span>
                        <span><i class="fa-solid fa-eye text-amber-400 mr-1"></i> Hallucination: <span id="hallu-display" class="font-bold text-slate-200">High</span></span>
                    </div>
                </div>

                <!-- Interactive HTML5 Canvas -->
                <div class="flex-grow w-full h-full relative bg-slate-950">
                    <canvas id="simCanvas"></canvas>

                    <!-- On-screen Alert Overlay for Critical Danger -->
                    <div id="danger-overlay" class="absolute bottom-4 left-4 right-4 bg-red-950/80 border border-red-500/50 p-3 rounded-xl backdrop-blur-md text-red-200 text-xs hidden flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation text-lg text-red-400 animate-bounce"></i>
                            <span><strong>เตือนอันตราย:</strong> ผู้ป่วยเข้าใกล้ระยะโจมตี และระดับอารมณ์คลั่งสูง เสี่ยงเกิดอันตรายต่อชีวิตบุคลากร!</span>
                        </div>
