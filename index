                </div>
            </div>
            <button onclick="openMissionModal()" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white rounded-xl text-xs md:text-sm font-semibold shadow-lg shadow-orange-500/20 flex items-center gap-2 transition duration-200">
